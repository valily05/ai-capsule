PORT=5000
CLIENT_URL=http://localhost:5174
# Leave blank for local SQLite. On Vercel, set DATABASE_URL to the Neon pooled PostgreSQL URL.
DATABASE_URL=
# Optional SQLite database path; defaults to server/database/capsules.sqlite.
# DATABASE_PATH=./database/capsules.sqlite

JWT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# Use "none" on Vercel when the frontend and API are separate Vercel projects.
COOKIE_SAME_SITE=lax
